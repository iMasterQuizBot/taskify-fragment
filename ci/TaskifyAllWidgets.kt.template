open class TaskifyBaseWidgetProvider(private val widgetNo: Int) : AppWidgetProvider() {
    override fun onEnabled(context: Context) {
        super.onEnabled(context)
        TaskifyAllWidgets.updateOne(context, widgetNo)
    }

    override fun onUpdate(context: Context, appWidgetManager: AppWidgetManager, appWidgetIds: IntArray) {
        for (id in appWidgetIds) {
            TaskifyAllWidgets.bind(context, appWidgetManager, id, widgetNo, null)
        }
    }

    override fun onAppWidgetOptionsChanged(
        context: Context,
        appWidgetManager: AppWidgetManager,
        appWidgetId: Int,
        newOptions: Bundle
    ) {
        super.onAppWidgetOptionsChanged(context, appWidgetManager, appWidgetId, newOptions)
        TaskifyAllWidgets.bind(context, appWidgetManager, appWidgetId, widgetNo, newOptions)
    }
}

class TaskifyWidgetActionReceiver : BroadcastReceiver() {
    override fun onReceive(context: Context, intent: Intent) {
        when (intent.action) {
            TaskifyAllWidgets.ACTION_COMPLETE_TOP -> {
                TaskifyAllWidgets.completeTopPendingTaskInDb(context)
                TaskifyAllWidgets.updateAll(context)
            }
            TaskifyAllWidgets.ACTION_SYNC -> {
                TaskifyAllWidgets.updateAll(context)
            }
        }
    }
}

object TaskifyAllWidgets {
    const val PREFS = "taskify_widget_prefs"
    const val ACTION_COMPLETE_TOP = "__PKG__.ACTION_COMPLETE_TOP"
    const val ACTION_SYNC = "__PKG__.ACTION_SYNC"

    private data class LiveSnapshot(
        val appTitle: String,
        val done: Int,
        val total: Int,
        val streak: Int,
        val studyMins: Int,
        val overdue: Int,
        val pending: Int,
        val weeklyPct: Int,
        val monthlyPct: Int,
        val mood: String,
        val energy: Int,
        val nextTask: String,
        val tasks: List<String>,
        val freezeTokens: Int,
        val weekBars: List<Float>,
        val bars14d: List<Float>,
        val catBars: List<Pair<String, Float>>,
        val catCounts: List<Pair<String, Int>>,
    )

    private fun readLiveSnapshot(context: Context): LiveSnapshot {
        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
        val appTitle = prefs.getString("title", "Taskifyy") ?: "Taskifyy"
        var done = prefs.getInt("done", 0)
        var total = prefs.getInt("total", 0)
        var streak = prefs.getInt("streak", 0)
        var studyMins = prefs.getInt("studyMins", 0)
        var overdue = prefs.getInt("overdueCount", 0)
        var pending = prefs.getInt("pendingCount", 0)
        var weeklyPct = prefs.getInt("weeklyPct", 0)
        var monthlyPct = prefs.getInt("monthlyPct", 0)
        var mood = prefs.getString("mood", "Focused") ?: "Focused"
        var energy = 82
        var nextTask = prefs.getString("nextTask", "No upcoming task") ?: "No upcoming task"
        var tasks = listOf(
            prefs.getString("task1", "Open Taskifyy to add tasks") ?: "",
            prefs.getString("task2", "") ?: "",
            prefs.getString("task3", "") ?: "",
            prefs.getString("task4", "") ?: "",
            prefs.getString("task5", "") ?: "",
        )
        var freezeTokens = 2
        val weekBars = MutableList(7) { 0.35f }
        val bars14d = MutableList(14) { 0.30f }
        val catDoneMap = linkedMapOf(
            "Study" to 0,
            "Work" to 0,
            "Health" to 0,
            "Fit" to 0,
            "Pers" to 0
        )

        try {
            val dbFile = context.getDatabasePath("my_daily_routine.db")
            if (dbFile.exists()) {
                val db = SQLiteDatabase.openDatabase(dbFile.path, null, SQLiteDatabase.OPEN_READONLY)
                val todayStr = SimpleDateFormat("yyyy-MM-dd", Locale.US).format(Date())
                val cal = Calendar.getInstance()
                val nowMins = cal.get(Calendar.HOUR_OF_DAY) * 60 + cal.get(Calendar.MINUTE)

                var dCount = 0
                var tCount = 0
                var pCount = 0
                var oCount = 0
                var sMins = 0
                val pList = mutableListOf<String>()

                val c = db.rawQuery(
                    "SELECT title, startMinutes, endMinutes, category, status FROM tasks WHERE date = ? ORDER BY startMinutes ASC, id ASC",
                    arrayOf(todayStr)
                )
                while (c.moveToNext()) {
                    val title = c.getString(0) ?: ""
                    val startM = c.getInt(1)
                    val endM = if (c.isNull(2)) null else c.getInt(2)
                    val cat = (c.getString(3) ?: "").lowercase(Locale.US)
                    val status = c.getString(4) ?: "pending"

                    if (status == "skipped") continue
                    tCount++
                    if (status == "completed") {
                        dCount++
                        if (cat == "study" || cat == "learning") {
                            val dur = (endM ?: (startM + 60)) - startM
                            if (dur > 0) sMins += dur
                            catDoneMap["Study"] = (catDoneMap["Study"] ?: 0) + 1
                        } else if (cat == "work") {
                            catDoneMap["Work"] = (catDoneMap["Work"] ?: 0) + 1
                        } else if (cat == "health") {
                            catDoneMap["Health"] = (catDoneMap["Health"] ?: 0) + 1
                        } else if (cat == "exercise") {
                            catDoneMap["Fit"] = (catDoneMap["Fit"] ?: 0) + 1
                        } else {
                            catDoneMap["Pers"] = (catDoneMap["Pers"] ?: 0) + 1
                        }
                    } else if (status == "pending") {
                        pCount++
                        val endCheck = endM ?: startM
                        if (nowMins > endCheck) oCount++
                        if (pList.size < 5) {
                            pList.add("${formatMins(startM)} • $title")
                        }
                    }
                }
                c.close()

                val fmt = SimpleDateFormat("yyyy-MM-dd", Locale.US)
                for (i in 0..13) {
                    val dCal = Calendar.getInstance()
                    dCal.add(Calendar.DAY_OF_YEAR, -(13 - i))
                    val dStr = fmt.format(dCal.time)
                    val dc = db.rawQuery("SELECT status FROM tasks WHERE date = ? AND status != 'skipped'", arrayOf(dStr))
                    var tot = 0
                    var dn = 0
                    while (dc.moveToNext()) {
                        tot++
                        if (dc.getString(0) == "completed") dn++
                    }
                    dc.close()
                    val ratio = if (tot == 0) 0.14f else (dn.toFloat() / tot.toFloat()).coerceIn(0.14f, 1.0f)
                    bars14d[i] = ratio
                    if (i >= 7) weekBars[i - 7] = ratio
                }

                val mCur = db.rawQuery("SELECT mood, energy FROM mood_logs WHERE date = ? LIMIT 1", arrayOf(todayStr))
                if (mCur.moveToFirst()) {
                    mood = mCur.getString(0) ?: mood
                    energy = (mCur.getInt(1) * 10).coerceIn(20, 100)
                }
                mCur.close()

                val fCur = db.rawQuery("SELECT value FROM settings WHERE key = 'streakFreezeTokens' LIMIT 1", null)
                if (fCur.moveToFirst()) {
                    freezeTokens = fCur.getString(0)?.toIntOrNull() ?: freezeTokens
                }
                fCur.close()
                db.close()

                done = dCount
                total = tCount
                pending = pCount
                overdue = oCount
                studyMins = sMins
                weeklyPct = ((weekBars.sum() / 7f) * 100f).toInt().coerceIn(0, 100)
                monthlyPct = ((bars14d.sum() / 14f) * 100f).toInt().coerceIn(0, 100)
                if (pList.isNotEmpty()) {
                    nextTask = pList.first()
                    tasks = pList
                } else if (tCount > 0 && pCount == 0) {
                    nextTask = "All tasks completed!"
                    tasks = listOf("All $tCount tasks done today!")
                }
            }
        } catch (_: Throwable) {}

        val maxCat = (catDoneMap.values.maxOrNull() ?: 1).coerceAtLeast(1)
        val catBars = catDoneMap.entries.map { it.key to (it.value.toFloat() / maxCat.toFloat()).coerceIn(0.18f, 1.0f) }
        val catCounts = catDoneMap.entries.map { it.key to it.value }

        return LiveSnapshot(
            appTitle = appTitle,
            done = done,
            total = total,
            streak = streak,
            studyMins = studyMins,
            overdue = overdue,
            pending = pending,
            weeklyPct = weeklyPct,
            monthlyPct = monthlyPct,
            mood = mood,
            energy = energy,
            nextTask = nextTask,
            tasks = tasks,
            freezeTokens = freezeTokens,
            weekBars = weekBars,
            bars14d = bars14d,
            catBars = catBars,
            catCounts = catCounts,
        )
    }

    fun completeTopPendingTaskInDb(context: Context) {
        try {
            val dbFile = context.getDatabasePath("my_daily_routine.db")
            if (!dbFile.exists()) return
            val db = SQLiteDatabase.openDatabase(dbFile.path, null, SQLiteDatabase.OPEN_READWRITE)
            val todayStr = SimpleDateFormat("yyyy-MM-dd", Locale.US).format(Date())
            val c = db.rawQuery(
                "SELECT id FROM tasks WHERE date = ? AND status = 'pending' ORDER BY startMinutes ASC, id ASC LIMIT 1",
                arrayOf(todayStr)
            )
            if (c.moveToFirst()) {
                val id = c.getInt(0)
                db.execSQL("UPDATE tasks SET status = 'completed' WHERE id = ?", arrayOf(id))
            }
            c.close()
            db.close()
        } catch (_: Throwable) {}
    }

    private fun formatMins(mins: Int): String {
        val h24 = (mins / 60) % 24
        val m = mins % 60
        val ap = if (h24 >= 12) "PM" else "AM"
        val h12 = if (h24 % 12 == 0) 12 else h24 % 12
        return String.format(Locale.US, "%d:%02d %s", h12, m, ap)
    }

    private fun launchIntent(context: Context, actionKey: String, reqCode: Int): PendingIntent {
        val intent = context.packageManager.getLaunchIntentForPackage(context.packageName)
            ?: Intent(Intent.ACTION_MAIN)
        intent.putExtra("widget_action", actionKey)
        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP)
        return PendingIntent.getActivity(
            context,
            reqCode,
            intent,
            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )
    }

    private fun broadcastIntent(context: Context, action: String, reqCode: Int): PendingIntent {
        val intent = Intent(context, TaskifyWidgetActionReceiver::class.java).apply { this.action = action }
        return PendingIntent.getBroadcast(
            context,
            reqCode,
            intent,
            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )
    }

    private fun drawRingBitmap(pct: Int, c1: Int, c2: Int, centerText: String, subText: String = ""): Bitmap {
        val size = 280
        val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val pad = 28f
        val rect = RectF(pad, pad, size - pad, size - pad)

        val bgPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE
            strokeWidth = 24f
            color = Color.parseColor("#2A3548")
        }
        canvas.drawArc(rect, 0f, 360f, false, bgPaint)

        val fgPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE
            strokeWidth = 24f
            strokeCap = Paint.Cap.ROUND
            shader = LinearGradient(0f, 0f, size.toFloat(), size.toFloat(), c1, c2, Shader.TileMode.CLAMP)
        }
        val sweep = (pct.coerceIn(0, 100) / 100f) * 360f
        canvas.drawArc(rect, -90f, sweep.coerceAtLeast(10f), false, fgPaint)

        val txtPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.WHITE
            textAlign = Paint.Align.CENTER
            textSize = if (centerText.length > 4) 44f else 54f
            typeface = Typeface.DEFAULT_BOLD
        }
        canvas.drawText(centerText, size / 2f, size / 2f + 16f, txtPaint)
        if (subText.isNotEmpty()) {
            val sPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                color = Color.parseColor("#94A3B8")
                textAlign = Paint.Align.CENTER
                textSize = 22f
            }
            canvas.drawText(subText, size / 2f, size / 2f + 46f, sPaint)
        }
        return bmp
    }

    private fun drawHabitRingBitmap(done: Int, total: Int): Bitmap {
        val size = 280
        val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val cx = size / 2f
        val cy = size / 2f
        val innerRect = RectF(56f, 56f, size - 56f, size - 56f)

        val pct = if (total == 0) 0 else (done * 100 / total)
        val innerBg = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE; strokeWidth = 18f; color = Color.parseColor("#2A3548")
        }
        canvas.drawArc(innerRect, 0f, 360f, false, innerBg)
        val innerFg = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE; strokeWidth = 18f; strokeCap = Paint.Cap.ROUND
            shader = LinearGradient(0f, 0f, size.toFloat(), size.toFloat(), Color.parseColor("#22D3EE"), Color.parseColor("#A855F7"), Shader.TileMode.CLAMP)
        }
        canvas.drawArc(innerRect, -90f, (pct / 100f * 360f).coerceAtLeast(16f), false, innerFg)

        // Outer 12 habit tiles
        val segPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
        val activeSegs = ((pct / 100f) * 12).toInt().coerceIn(1, 12)
        for (i in 0 until 12) {
            val ang = Math.toRadians((i * 30.0) - 90.0)
            val rx = cx + (Math.cos(ang) * 112f).toFloat()
            val ry = cy + (Math.sin(ang) * 112f).toFloat()
            segPaint.color = if (i < activeSegs) Color.parseColor("#A855F7") else Color.parseColor("#263044")
            canvas.drawRoundRect(RectF(rx - 10f, ry - 10f, rx + 10f, ry + 10f), 5f, 5f, segPaint)
        }

        val tPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.WHITE; textAlign = Paint.Align.CENTER; textSize = 42f; typeface = Typeface.DEFAULT_BOLD
        }
        canvas.drawText("$done/${total.coerceAtLeast(1)}", cx, cy + 14f, tPaint)
        return bmp
    }

    private fun drawDualRingBitmap(pct: Int, streak: Int): Bitmap {
        val size = 280
        val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val r1 = RectF(26f, 26f, size - 26f, size - 26f)
        val r2 = RectF(60f, 60f, size - 60f, size - 60f)

        val bg = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; strokeWidth = 18f; color = Color.parseColor("#253042") }
        canvas.drawArc(r1, 0f, 360f, false, bg)
        canvas.drawArc(r2, 0f, 360f, false, bg)

        val p1 = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE; strokeWidth = 18f; strokeCap = Paint.Cap.ROUND; color = Color.parseColor("#22D3EE")
        }
        val p2 = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE; strokeWidth = 18f; strokeCap = Paint.Cap.ROUND; color = Color.parseColor("#A855F7")
        }
        canvas.drawArc(r1, -90f, (pct / 100f * 360f).coerceAtLeast(18f), false, p1)
        canvas.drawArc(r2, -90f, ((streak.coerceAtMost(30) / 30f) * 360f).coerceAtLeast(24f), false, p2)

        val tPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.WHITE; textAlign = Paint.Align.CENTER; textSize = 38f; typeface = Typeface.DEFAULT_BOLD
        }
        canvas.drawText("$pct%", size / 2f, size / 2f + 10f, tPaint)
        return bmp
    }

    private fun drawBarChartBitmap(bars: List<Float>, labels: List<String>, cTop: Int, cBot: Int, rectangular: Boolean = false): Bitmap {
        val w = 480
        val h = 210
        val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val count = bars.size.coerceAtLeast(1)
        val colW = (w - 36f) / count
        val barW = (colW * 0.56f).coerceAtMost(38f)
        val maxH = h - 48f
        val rad = if (rectangular) 6f else barW / 2f

        val trackPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#232C40") }
        val lblPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.parseColor("#94A3B8")
            textAlign = Paint.Align.CENTER
            textSize = if (count > 8) 15f else 19f
        }
        val valPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.parseColor("#E2E8F0")
            textAlign = Paint.Align.CENTER
            textSize = 15f
            typeface = Typeface.DEFAULT_BOLD
        }

        for (i in 0 until count) {
            val cx = 18f + i * colW + colW / 2f
            val left = cx - barW / 2f
            val right = cx + barW / 2f
            val topTrack = 20f
            val botTrack = maxH + 14f

            canvas.drawRoundRect(RectF(left, topTrack, right, botTrack), rad, rad, trackPaint)

            val ratio = bars[i].coerceIn(0.10f, 1.0f)
            val barTop = botTrack - (maxH - 6f) * ratio
            val barPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                shader = LinearGradient(left, barTop, right, botTrack, cTop, cBot, Shader.TileMode.CLAMP)
            }
            canvas.drawRoundRect(RectF(left, barTop, right, botTrack), rad, rad, barPaint)

            if (rectangular && count <= 7) {
                canvas.drawText("${(ratio * 100).toInt()}%", cx, barTop - 4f, valPaint)
            }
            if (i < labels.size) {
                canvas.drawText(labels[i], cx, h - 8f, lblPaint)
            }
        }
        return bmp
    }

    private fun drawCategoryStackedBitmap(catCounts: List<Pair<String, Int>>): Bitmap {
        val w = 480
        val h = 110
        val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val colors = listOf(
            Color.parseColor("#22D3EE"),
            Color.parseColor("#FBBF24"),
            Color.parseColor("#3B82F6"),
            Color.parseColor("#A855F7"),
            Color.parseColor("#FB7185"),
        )
        val total = catCounts.sumOf { it.second }.coerceAtLeast(1)
        var x = 12f
        val availW = w - 24f
        val barRect = RectF(12f, 16f, w - 12f, 48f)
        val bgP = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#232C40") }
        canvas.drawRoundRect(barRect, 16f, 16f, bgP)

        val segP = Paint(Paint.ANTI_ALIAS_FLAG)
        val dotP = Paint(Paint.ANTI_ALIAS_FLAG)
        val txtP = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#CBD5E1"); textSize = 19f }

        catCounts.forEachIndexed { idx, pair ->
            val frac = if (catCounts.sumOf { it.second } == 0) 0.2f else (pair.second.toFloat() / total.toFloat()).coerceAtLeast(0.08f)
            val segW = (availW * frac).coerceAtMost((w - 12f) - x)
            segP.color = colors[idx % colors.size]
            if (segW > 4f) {
                canvas.drawRoundRect(RectF(x, 16f, x + segW - 2f, 48f), 8f, 8f, segP)
                x += segW
            }
            val lx = 16f + idx * 92f
            dotP.color = colors[idx % colors.size]
            canvas.drawCircle(lx, 84f, 6f, dotP)
            canvas.drawText(pair.first, lx + 12f, 90f, txtP)
        }
        return bmp
    }

    private fun drawMoodEnergyBitmap(moodPct: Int, energyPct: Int): Bitmap {
        val w = 440
        val h = 150
        val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val trackP = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#232C40") }
        val lblP = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE; textSize = 24f; typeface = Typeface.DEFAULT_BOLD }

        // Row 1: Mood
        canvas.drawText("Mood", 12f, 42f, lblP)
        canvas.drawRoundRect(RectF(110f, 22f, w - 16f, 48f), 13f, 13f, trackP)
        val mPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            shader = LinearGradient(110f, 0f, w - 16f, 0f, Color.parseColor("#22D3EE"), Color.parseColor("#34D399"), Shader.TileMode.CLAMP)
        }
        val mEnd = 110f + ((w - 126f) * (moodPct / 100f))
        canvas.drawRoundRect(RectF(110f, 22f, mEnd, 48f), 13f, 13f, mPaint)

        // Row 2: Energy
        canvas.drawText("Energy", 12f, 108f, lblP)
        canvas.drawRoundRect(RectF(110f, 88f, w - 16f, 114f), 13f, 13f, trackP)
        val ePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            shader = LinearGradient(110f, 0f, w - 16f, 0f, Color.parseColor("#F472B6"), Color.parseColor("#FBBF24"), Shader.TileMode.CLAMP)
        }
        val eEnd = 110f + ((w - 126f) * (energyPct / 100f))
        canvas.drawRoundRect(RectF(110f, 88f, eEnd, 114f), 13f, 13f, ePaint)
        return bmp
    }

    private fun drawMiniCalendarBitmap(): Bitmap {
        val w = 440
        val h = 230
        val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val cal = Calendar.getInstance()
        val todayDay = cal.get(Calendar.DAY_OF_MONTH)
        val maxDays = cal.getActualMaximum(Calendar.DAY_OF_MONTH)
        cal.set(Calendar.DAY_OF_MONTH, 1)
        val startDow = ((cal.get(Calendar.DAY_OF_WEEK) + 5) % 7) // Mon=0..Sun=6

        val hdrP = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#94A3B8"); textAlign = Paint.Align.CENTER; textSize = 18f; typeface = Typeface.DEFAULT_BOLD }
        val dayP = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#E2E8F0"); textAlign = Paint.Align.CENTER; textSize = 19f }
        val hiBg = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#22D3EE") }
        val hiTxt = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#0B0E14"); textAlign = Paint.Align.CENTER; textSize = 19f; typeface = Typeface.DEFAULT_BOLD }

        val headers = listOf("M", "T", "W", "T", "F", "S", "S")
        val colW = w / 7f
        for (c in 0..6) canvas.drawText(headers[c], c * colW + colW / 2f, 24f, hdrP)

        var row = 1
        var col = startDow
        for (d in 1..maxDays) {
            val cx = col * colW + colW / 2f
            val cy = 28f + row * 34f
            if (d == todayDay) {
                canvas.drawRoundRect(RectF(cx - 16f, cy - 18f, cx + 16f, cy + 8f), 8f, 8f, hiBg)
                canvas.drawText("$d", cx, cy, hiTxt)
            } else {
                canvas.drawText("$d", cx, cy, dayP)
            }
            col++
            if (col >= 7) { col = 0; row++ }
        }
        return bmp
    }

    private fun drawHeatmapBitmap(bars14d: List<Float>): Bitmap {
        val w = 460
        val h = 160
        val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val p = Paint(Paint.ANTI_ALIAS_FLAG)
        val cols = 7
        val rows = 2
        val cellW = (w - 36f) / cols
        val cellH = (h - 24f) / rows
        for (i in 0 until 14) {
            val r = i / cols
            val c = i % cols
            val v = bars14d[i]
            p.color = when {
                v >= 0.8f -> Color.parseColor("#22D3EE")
                v >= 0.5f -> Color.parseColor("#34D399")
                v >= 0.25f -> Color.parseColor("#A855F7")
                else -> Color.parseColor("#232C40")
            }
            val left = 18f + c * cellW + 4f
            val top = 12f + r * cellH + 4f
            canvas.drawRoundRect(RectF(left, top, left + cellW - 8f, top + cellH - 8f), 10f, 10f, p)
        }
        return bmp
    }

    private fun drawHorizontalProgressBitmap(pct: Int, c1: Int, c2: Int): Bitmap {
        val w = 360
        val h = 68
        val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val track = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#232C40") }
        canvas.drawRoundRect(RectF(10f, 20f, w - 10f, 48f), 14f, 14f, track)
        val fill = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            shader = LinearGradient(10f, 0f, w - 10f, 0f, c1, c2, Shader.TileMode.CLAMP)
        }
        val endX = 10f + ((w - 20f) * (pct.coerceIn(5, 100) / 100f))
        canvas.drawRoundRect(RectF(10f, 20f, endX, 48f), 14f, 14f, fill)
        return bmp
    }

    private fun drawOrbBitmap(c1: Int, c2: Int, label: String): Bitmap {
        val size = 240
        val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val glow = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = c1; alpha = 65
        }
        canvas.drawCircle(size / 2f, size / 2f, 100f, glow)
        val orb = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            shader = LinearGradient(20f, 20f, size - 20f, size - 20f, c1, c2, Shader.TileMode.CLAMP)
        }
        canvas.drawCircle(size / 2f, size / 2f, 74f, orb)
        val txt = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.WHITE; textAlign = Paint.Align.CENTER; textSize = 34f; typeface = Typeface.DEFAULT_BOLD
        }
        canvas.drawText(label, size / 2f, size / 2f + 12f, txt)
        return bmp
    }

    private fun getLayoutId(context: Context, widgetNo: Int): Int {
        val name = String.format(Locale.US, "tg_layout_%02d", widgetNo)
        return context.resources.getIdentifier(name, "layout", context.packageName)
    }

    private fun getId(context: Context, name: String): Int {
        return context.resources.getIdentifier(name, "id", context.packageName)
    }

    fun bind(context: Context, manager: AppWidgetManager, widgetId: Int, widgetNo: Int, options: Bundle? = null) {
        val layoutId = getLayoutId(context, widgetNo)
        if (layoutId == 0) return

        val snap = readLiveSnapshot(context)
        val pct = if (snap.total == 0) 0 else ((snap.done * 100) / snap.total)
        val studyHrs = String.format(Locale.US, "%dh %02dm", snap.studyMins / 60, snap.studyMins % 60)
        val dayLabels = listOf("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
        val catLabels = snap.catBars.map { it.first }
        val catVals = snap.catBars.map { it.second }

        val views = RemoteViews(context.packageName, layoutId)
        val idRoot = getId(context, "wg_root")
        val idTitle = getId(context, "wg_title")
        val idSub = getId(context, "wg_sub")
        val idBadge = getId(context, "wg_badge")
        val idBody = getId(context, "wg_body")
        val idCanvas = getId(context, "wg_canvas")
        val idBtn1 = getId(context, "wg_btn_1")
        val idBtn2 = getId(context, "wg_btn_2")

        var actionKey = "open_today"
        var titleStr = snap.appTitle
        var badgeStr = "LIVE"
        var bodyStr = snap.nextTask
        var bmp: Bitmap? = null

        when (widgetNo) {
            1, 48, 82, 84 -> {
                titleStr = "Today Progress"; badgeStr = "${snap.done}/${snap.total}"
                bodyStr = "${snap.pending} pending today"
                bmp = drawRingBitmap(pct, Color.parseColor("#22D3EE"), Color.parseColor("#3B82F6"), "$pct%", "done")
            }
            2 -> {
                titleStr = "Streak"; badgeStr = "${snap.streak}d"
                bodyStr = "${snap.streak} Days fire streak"
                bmp = drawOrbBitmap(Color.parseColor("#F97316"), Color.parseColor("#A855F7"), "${snap.streak}d")
            }
            3, 47, 55, 56 -> {
                titleStr = if (widgetNo == 47) "Critical Tasks" else "Today"
                badgeStr = "${snap.done}/${snap.total}"
                bodyStr = snap.tasks.take(3).filter { it.isNotBlank() }.joinToString("\n")
                bmp = drawHorizontalProgressBitmap(pct, Color.parseColor("#22D3EE"), Color.parseColor("#A855F7"))
            }
            4 -> {
                titleStr = "Next Up"; badgeStr = "IST"
                bodyStr = snap.nextTask
                bmp = drawOrbBitmap(Color.parseColor("#6366F1"), Color.parseColor("#A855F7"), "NEXT")
            }
            5, 31 -> {
                titleStr = "Focus Timer"; badgeStr = "25:00"
                bodyStr = "Live countdown"
                bmp = drawRingBitmap(65, Color.parseColor("#22D3EE"), Color.parseColor("#34D399"), "25:00", "focus")
                actionKey = "open_focus_25"
            }
            32 -> {
                titleStr = "Pomodoro 50/10"; badgeStr = "50:00"
                bodyStr = "Deep work timer"
                bmp = drawRingBitmap(75, Color.parseColor("#A855F7"), Color.parseColor("#22D3EE"), "50:00", "deep")
                actionKey = "open_focus_50"
            }
            6, 23, 64 -> {
                titleStr = "Study Time"; badgeStr = studyHrs
                bodyStr = "$studyHrs today tracker"
                bmp = drawHorizontalProgressBitmap((snap.studyMins / 3).coerceIn(10, 100), Color.parseColor("#A855F7"), Color.parseColor("#22D3EE"))
            }
            7, 88 -> {
                titleStr = "Weekly"; badgeStr = "${snap.weeklyPct}%"
                bodyStr = "7-day completion bars"
                bmp = drawBarChartBitmap(snap.weekBars, dayLabels, Color.parseColor("#C084FC"), Color.parseColor("#38BDF8"), false)
                actionKey = "open_insights"
            }
            52, 77 -> {
                titleStr = "Weekly Columns"; badgeStr = "${snap.weeklyPct}%"
                bodyStr = "Rectangular 7-day columns"
                bmp = drawBarChartBitmap(snap.weekBars, dayLabels, Color.parseColor("#22D3EE"), Color.parseColor("#A855F7"), true)
                actionKey = "open_insights"
            }
            53, 78, 98 -> {
                titleStr = "Category Columns"; badgeStr = "${snap.done} done"
                bodyStr = "Category completion columns"
                bmp = drawBarChartBitmap(catVals, catLabels, Color.parseColor("#34D399"), Color.parseColor("#22D3EE"), true)
                actionKey = "open_insights"
            }
            54 -> {
                titleStr = "14-Day Trend"; badgeStr = "${snap.monthlyPct}%"
                bodyStr = "14-day progress bars"
                bmp = drawBarChartBitmap(snap.bars14d, List(14) { "${it + 1}" }, Color.parseColor("#34D399"), Color.parseColor("#22D3EE"), false)
                actionKey = "open_insights"
            }
            8 -> {
                titleStr = "Monthly"; badgeStr = "${snap.monthlyPct}%"
                bodyStr = "High-score: ${snap.monthlyPct}%"
                bmp = drawRingBitmap(snap.monthlyPct, Color.parseColor("#60A5FA"), Color.parseColor("#A855F7"), "${snap.monthlyPct}%", "score")
                actionKey = "open_insights"
            }
            9, 71 -> {
                titleStr = "Categories"; badgeStr = "${snap.done}"
                bodyStr = "Work • Study • Health"
                bmp = drawCategoryStackedBitmap(snap.catCounts)
                actionKey = "open_insights"
            }
            10, 44, 68 -> {
                titleStr = "Quick Add"; badgeStr = "+"
                bodyStr = "Tap to create task"
                bmp = drawHorizontalProgressBitmap(100, Color.parseColor("#3B82F6"), Color.parseColor("#22D3EE"))
                actionKey = "open_quick_add"
            }
            11, 43 -> {
                titleStr = "AI Voice"; badgeStr = "LIVE"
                bodyStr = "Instant voice tasks"
                bmp = drawOrbBitmap(Color.parseColor("#22D3EE"), Color.parseColor("#EC4899"), "MIC")
                actionKey = "open_live_voice"
            }
            12, 76 -> {
                titleStr = "Ask Taskifyy AI"; badgeStr = "AI"
                bodyStr = "Offline + API AI"
                bmp = drawHorizontalProgressBitmap(90, Color.parseColor("#22D3EE"), Color.parseColor("#A855F7"))
                actionKey = "open_offline_ai"
            }
            13 -> {
                titleStr = "Mood & Energy"; badgeStr = snap.mood
                bodyStr = "${snap.mood} • Energy ${snap.energy}%"
                bmp = drawMoodEnergyBitmap(78, snap.energy)
            }
            14 -> {
                titleStr = "Calendar"; badgeStr = "MONTH"
                bodyStr = "Mini monthly calendar"
                bmp = drawMiniCalendarBitmap()
                actionKey = "open_calendar"
            }
            15, 59, 89 -> {
                titleStr = "Overdue"; badgeStr = "${snap.overdue}"
                bodyStr = "${snap.overdue} items overdue!"
                bmp = drawRingBitmap((snap.overdue * 20).coerceIn(10, 100), Color.parseColor("#FB7185"), Color.parseColor("#EF4444"), "${snap.overdue}", "due")
                actionKey = "open_overdue"
            }
            16, 66 -> {
                titleStr = "Revision"; badgeStr = "1,3,7,21"
                bodyStr = "Spaced repetition"
                bmp = drawHorizontalProgressBitmap(pct, Color.parseColor("#22D3EE"), Color.parseColor("#34D399"))
            }
            17 -> {
                titleStr = "Good Morning!"; badgeStr = "${snap.total} tasks"
                bodyStr = "${snap.done} done • ${snap.pending} pending today"
                bmp = drawHorizontalProgressBitmap(pct, Color.parseColor("#FBBF24"), Color.parseColor("#22D3EE"))
            }
            18, 83, 85 -> {
                titleStr = "Habits"; badgeStr = "${snap.done}/${snap.total}"
                bodyStr = "Habit Ring"
                bmp = drawHabitRingBitmap(snap.done, snap.total)
            }
            19, 96 -> {
                titleStr = "Inspiration"; badgeStr = "DAILY"
                bodyStr = "Done is better than perfect."
                bmp = drawHorizontalProgressBitmap(100, Color.parseColor("#34D399"), Color.parseColor("#22D3EE"))
            }
            20, 67 -> {
                titleStr = "Shield"; badgeStr = "${snap.freezeTokens}"
                bodyStr = "Streak Freeze: ${snap.freezeTokens} available"
                bmp = drawOrbBitmap(Color.parseColor("#22D3EE"), Color.parseColor("#3B82F6"), "${snap.freezeTokens}")
            }
            28, 97 -> {
                titleStr = "Study Hub"; badgeStr = studyHrs
                bodyStr = "${snap.weeklyPct}% weekly • ${snap.streak}d streak"
                bmp = drawBarChartBitmap(snap.weekBars, dayLabels, Color.parseColor("#22D3EE"), Color.parseColor("#A855F7"), true)
                actionKey = "open_insights"
            }
            41 -> {
                titleStr = "Offline AI"; badgeStr = "READY"
                bodyStr = "Human-like local AI"
                bmp = drawOrbBitmap(Color.parseColor("#22D3EE"), Color.parseColor("#34D399"), "AI")
                actionKey = "open_offline_ai"
            }
            42, 36 -> {
                titleStr = "API AI"; badgeStr = "FULL"
                bodyStr = "365d + 8 Repeat Modes"
                bmp = drawOrbBitmap(Color.parseColor("#A855F7"), Color.parseColor("#22D3EE"), "API")
                actionKey = "open_api_ai"
            }
            37 -> {
                titleStr = "DeepSeek Web"; badgeStr = "WEB"
                bodyStr = "Instant DeepSeek open"
                bmp = drawOrbBitmap(Color.parseColor("#3B82F6"), Color.parseColor("#A855F7"), "DS")
                actionKey = "open_deepseek"
            }
            79 -> {
                titleStr = "Progress & Streak"; badgeStr = "$pct%"
                bodyStr = "${snap.streak}d streak • ${snap.done}/${snap.total}"
                bmp = drawDualRingBitmap(pct, snap.streak)
            }
            80, 92 -> {
                titleStr = "Monthly Heatmap"; badgeStr = "${snap.monthlyPct}%"
                bodyStr = "14-day consistency"
                bmp = drawHeatmapBitmap(snap.bars14d)
                actionKey = "open_insights"
            }
            38, 99, 100 -> {
                titleStr = if (widgetNo == 100) "AI Command Hub" else "Taskifyy Pro"
                badgeStr = "$pct%"
                bodyStr = "${snap.done}/${snap.total} done • ${snap.streak}d streak • $studyHrs"
                bmp = drawBarChartBitmap(snap.weekBars, dayLabels, Color.parseColor("#22D3EE"), Color.parseColor("#A855F7"), true)
                if (widgetNo == 100) actionKey = "open_api_ai"
            }
            51, 81, 86 -> {
                titleStr = "Study Ring"; badgeStr = studyHrs
                bodyStr = "$studyHrs studied today"
                bmp = drawRingBitmap((snap.studyMins / 3).coerceIn(10, 100), Color.parseColor("#34D399"), Color.parseColor("#22D3EE"), studyHrs, "study")
            }
            57 -> {
                titleStr = "PYQ Target"; badgeStr = "$pct%"
                bodyStr = "PYQs & Mock progress"
                bmp = drawRingBitmap(pct, Color.parseColor("#FBBF24"), Color.parseColor("#F97316"), "$pct%", "PYQ")
            }
            else -> {
                titleStr = "Taskifyy"; badgeStr = "$pct%"
                bodyStr = "${snap.done}/${snap.total} done • ${snap.nextTask}"
                bmp = drawHorizontalProgressBitmap(pct, Color.parseColor("#22D3EE"), Color.parseColor("#A855F7"))
            }
        }

        if (idTitle != 0) views.setTextViewText(idTitle, titleStr)
        if (idSub != 0) views.setTextViewText(idSub, bodyStr)
        if (idBadge != 0) views.setTextViewText(idBadge, badgeStr)
        if (idBody != 0) views.setTextViewText(idBody, bodyStr)
        if (idCanvas != 0 && bmp != null) views.setImageViewBitmap(idCanvas, bmp)

        val pi = launchIntent(context, actionKey, 1000 + widgetNo)
        if (idRoot != 0) views.setOnClickPendingIntent(idRoot, pi)
        if (idBtn1 != 0) {
            if (widgetNo == 45) {
                views.setTextViewText(idBtn1, "Done Top")
                views.setOnClickPendingIntent(idBtn1, broadcastIntent(context, ACTION_COMPLETE_TOP, 2000 + widgetNo))
            } else {
                views.setOnClickPendingIntent(idBtn1, pi)
            }
        }
        if (idBtn2 != 0) {
            views.setOnClickPendingIntent(idBtn2, broadcastIntent(context, ACTION_SYNC, 3000 + widgetNo))
        }

        manager.updateAppWidget(widgetId, views)
    }

    fun updateOne(context: Context, widgetNo: Int) {
        val mgr = AppWidgetManager.getInstance(context)
        val clsName = String.format(Locale.US, "%s.TaskifyWidget%02d", context.packageName, widgetNo)
        try {
            val cn = ComponentName(context.packageName, clsName)
            val ids = mgr.getAppWidgetIds(cn)
            for (id in ids) bind(context, mgr, id, widgetNo, mgr.getAppWidgetOptions(id))
        } catch (_: Throwable) {}
    }

    fun updateAll(context: Context) {
        for (i in 1..100) updateOne(context, i)
    }
}

