package __PKG__

import android.content.ActivityNotFoundException
import android.content.Intent
import android.media.AudioAttributes
import android.media.AudioFormat
import android.media.AudioTrack
import android.speech.tts.TextToSpeech
import androidx.core.content.FileProvider
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel
import java.io.File
import java.util.concurrent.Executors

class MainActivity : FlutterActivity() {
    private val audioExecutor = Executors.newSingleThreadExecutor()
    private var track: AudioTrack? = null

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)

        // 1) साउंड फ़ाइल के लिए content:// URI (नोटिफिकेशन साउंड)
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "taskify/sound")
            .setMethodCallHandler { call, result ->
                if (call.method == "contentUri") {
                    val path = call.argument<String>("path")
                    if (path == null) {
                        result.error("ARG", "path missing", null)
                        return@setMethodCallHandler
                    }
                    try {
                        val uri = FileProvider.getUriForFile(this, packageName + ".taskifysounds", File(path))
                        grantUriPermission("com.android.systemui", uri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
                        result.success(uri.toString())
                    } catch (e: Exception) {
                        result.error("URI", e.message, null)
                    }
                } else {
                    result.notImplemented()
                }
            }

        // 2) Live AI की आवाज़ का PCM प्लेबैक (AudioTrack, streaming)
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "taskify/pcm")
            .setMethodCallHandler { call, result ->
                when (call.method) {
                    "start" -> {
                        val rate = call.argument<Int>("rate") ?: 24000
                        audioExecutor.execute { startTrack(rate) }
                        result.success(null)
                    }
                    "write" -> {
                        val bytes = call.argument<ByteArray>("bytes")
                        if (bytes != null) {
                            audioExecutor.execute { track?.write(bytes, 0, bytes.size) }
                        }
                        result.success(null)
                    }
                    "flush" -> {
                        audioExecutor.execute {
                            track?.pause()
                            track?.flush()
                            track?.play()
                        }
                        result.success(null)
                    }
                    "stop" -> {
                        audioExecutor.execute { stopTrack() }
                        result.success(null)
                    }
                    else -> result.notImplemented()
                }
            }

        // 3) आवाज़ों का डेटा डाउनलोड/मैनेज करने के लिए Android के असली TTS
        // इंजन (Google Text-to-Speech) की सेटिंग/डेटा-इंस्टॉलर खोलना।
        // नोट: Android किसी भी ऐप को किसी "एक ख़ास" आवाज़ को सीधे डाउनलोड करने
        // का तरीका नहीं देता — सिर्फ़ Google TTS का अपना डेटा-मैनेजर खोला जा
        // सकता है, जहाँ से यूज़र भाषा चुनकर उसका डेटा डाउनलोड करता है। इसलिए
        // यह बटन "वो आधिकारिक स्क्रीन" खोलता है, न कि किसी एक voice को छुपाकर
        // अपने-आप डाउनलोड करता है (जो Android में किसी भी ऐप के लिए संभव नहीं)।
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "taskify/tts")
            .setMethodCallHandler { call, result ->
                if (call.method == "openVoiceData") {
                    try {
                        val intent = Intent(TextToSpeech.Engine.ACTION_INSTALL_TTS_DATA)
                        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                        startActivity(intent)
                        result.success(true)
                    } catch (e: ActivityNotFoundException) {
                        result.success(false)
                    } catch (e: Exception) {
                        result.error("TTS_DATA", e.message, null)
                    }
                } else {
                    result.notImplemented()
                }
            }
    }

    private fun startTrack(rate: Int) {
        stopTrack()
        val minBuf = AudioTrack.getMinBufferSize(rate, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT)
        track = AudioTrack.Builder()
            .setAudioAttributes(
                AudioAttributes.Builder()
                    .setUsage(AudioAttributes.USAGE_MEDIA)
                    .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
                    .build()
            )
            .setAudioFormat(
                AudioFormat.Builder()
                    .setSampleRate(rate)
                    .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
                    .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                    .build()
            )
            .setBufferSizeInBytes(minBuf * 4)
            .setTransferMode(AudioTrack.MODE_STREAM)
            .build()
        track?.play()
    }

    private fun stopTrack() {
        try {
            track?.stop()
        } catch (_: Exception) {
        }
        track?.release()
        track = null
    }

    override fun onDestroy() {
        audioExecutor.execute { stopTrack() }
        audioExecutor.shutdown()
        super.onDestroy()
    }
}
