<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tg_bg_emerald"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/wg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consistency"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/wg_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="84% weekly"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/wg_canvas"
        android:layout_width="96dp"
        android:layout_height="44dp"
        android:src="@drawable/tg_prev_hbar_emerald"
        android:scaleType="fitCenter"
        android:contentDescription="Widget Visual"/>
    <TextView
        android:id="@+id/wg_btn_1"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/tg_btn_cyan"
        android:gravity="center"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:text="Open"
        android:textColor="#F8FAFC"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginStart="6dp"/>
</LinearLayout>
