            31 -> { setTxt("wg_title", "POMODORO"); setTxt("wg_big", "25 / 5"); setTxt("wg_sub", "Study Cycle"); setBmp(drawRingBitmap(80, cCyan, cViolet, "25/5")) }
            32 -> { setTxt("wg_title", "LONG FOCUS"); setTxt("wg_big", "50 / 10"); setTxt("wg_sub", "Study Cycle"); setBmp(drawRingBitmap(85, cEmerald, cCyan, "50/10")) }
            33 -> { setTxt("wg_title", "Night Review Chart"); setTxt("wg_badge", "$pct%"); setTxt("wg_line1", "Completed: ${snap.done} • Left: ${snap.pending}"); setProg(pct); setBmp(drawBarChartBitmap(catVals, catLabels, cAmber, cRose)) }
            34 -> { setTxt("wg_title", "DAILY TARGET"); setTxt("wg_big", "$pct%"); setTxt("wg_sub", "Goal: 80%"); setBmp(drawRingBitmap(pct, cAmber, cRose, "$pct%")) }
            35 -> { setTxt("wg_title", "Next: ${snap.nextTask}"); setTxt("wg_badge", "${snap.overdue} due") }
            36 -> { setTxt("wg_title", "✨ API AI"); setTxt("wg_badge", "Open") }
            37 -> { setTxt("wg_title", "🌐 DeepSeek"); setTxt("wg_badge", "Web") }
            38 -> { setTxt("wg_title", "${snap.appTitle} Command"); setTxt("wg_badge", "🔥 ${snap.streak}d • $pct%"); setTxt("wg_line1", "Study: $studyTxt • Mood: ${snap.mood}"); setTxt("wg_line2", t1); setTxt("wg_line3", t2); setTxt("wg_line4", t3); setTxt("wg_line5", "Weekly: ${snap.weeklyPct}% • Overdue: ${snap.overdue}"); setProg(pct); setBmp(drawBarChartBitmap(snap.weekBars, weekLabels, cCyan, cEmerald)) }
            39 -> { setTxt("wg_title", "COMPLETED"); setTxt("wg_big", "🏆 ${snap.done}"); setTxt("wg_sub", "Out of ${snap.total}"); setBmp(drawBarChartBitmap(catVals, catLabels, cEmerald, cCyan)) }
            40 -> { setTxt("wg_title", "$dateStr • ${snap.mood}"); setTxt("wg_badge", "$pct%") }
            41 -> { setTxt("wg_title", "⚡ Offline AI Control"); setTxt("wg_badge", "Streak ${snap.streak}d"); setTxt("wg_line1", "Pending: ${snap.pending} • Done: ${snap.done} • Instant Offline AI") }
            42 -> { setTxt("wg_title", "✨ API AI Control"); setTxt("wg_badge", "$pct% Today"); setTxt("wg_line1", "Gemini & DeepSeek • Full App Control") }
        }

        val rootAction = when (no) {
            5, 30, 31, 32 -> "focus_timer"
            6, 7, 8, 9, 23 -> "stats"
            10 -> "add_task"
            11 -> "voice_orb"
            12, 41 -> "offline_ai"
            14 -> "calendar"
            36, 42 -> "api_ai"
            37 -> "deepseek_web"
            else -> "today"
        }
        setClickAction("wg_root", 100 + no, rootAction)
        setBroadcastAction("wg_btn_done", 200 + no, ACTION_COMPLETE_TOP)
        setBroadcastAction("wg_btn_sync", 300 + no, ACTION_SYNC)
        setClickAction("wg_btn_add", 400 + no, "add_task")
        setClickAction("wg_btn_voice", 500 + no, "voice_orb")
        setClickAction("wg_btn_chat", 600 + no, if (no == 41) "offline_ai" else "api_ai")

        mgr.updateAppWidget(appWidgetId, views)
    }
}

