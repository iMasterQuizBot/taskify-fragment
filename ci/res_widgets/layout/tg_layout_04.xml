<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tg_bg_violet"
    android:orientation="vertical"
    android:padding="11dp">
    <TextView
        android:id="@+id/wg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="NEXT UP"
        android:textColor="#A7B0C0"
        android:textSize="10sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/wg_big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="⏳ 06:00"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/wg_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Study Session"
        android:textColor="#22D3EE"
        android:textSize="10.5sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/wg_btn_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/tg_btn_cyan"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="✓ Complete"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
