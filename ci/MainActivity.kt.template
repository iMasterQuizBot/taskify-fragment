package __PKG__

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.app.Service
import android.content.ActivityNotFoundException
import android.content.Intent
import android.content.pm.ServiceInfo
import android.media.AudioAttributes
import android.media.AudioFormat
import android.media.AudioTrack
import android.os.Build
import android.os.Bundle
import android.view.Display
import android.view.WindowManager
import android.os.IBinder
import android.speech.tts.TextToSpeech
import androidx.core.content.FileProvider
import io.flutter.embedding.android.FlutterFragmentActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel
import java.io.File
import java.util.concurrent.Executors

class MainActivity : FlutterFragmentActivity() {
    private var targetHz: Float = 120f

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        window.setFlags(
            WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED,
            WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED
        )
        applyRefreshRate(targetHz)
    }

    override fun onResume() {
        super.onResume()
        applyRefreshRate(targetHz)
        try { TaskifyWidgetProvider.updateAll(this) } catch (_: Exception) {}
    }

    private fun applyRefreshRate(hz: Float) {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
            try {
                val disp = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) display else windowManager.defaultDisplay
                val cur = disp?.mode ?: return
                val modes = disp.supportedModes
                val matching = modes.filter { it.physicalWidth == cur.physicalWidth && it.physicalHeight == cur.physicalHeight }
                val best = if (hz >= 110f) {
                    matching.maxByOrNull { it.refreshRate }
                } else {
                    matching.minByOrNull { kotlin.math.abs(it.refreshRate - hz) }
                }
                if (best != null) {
                    val attrs = window.attributes
                    attrs.preferredDisplayModeId = best.modeId
                    window.attributes = attrs
                }
            } catch (_: Exception) {}
        }
    }
    private val audioExecutor = Executors.newSingleThreadExecutor()
    private var track: AudioTrack? = null

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)

        // 1) साउंड फ़ाइल के लिए content:// URI (नोटिफिकेशन साउंड)
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "taskify/sound")
            .setMethodCallHandler { call, result ->
                if (call.method == "contentUri") {
                    val path = call.argument<String>("path")
                    if (path == null) {
                        result.error("ARG", "path missing", null)
                        return@setMethodCallHandler
                    }
                    try {
                        val uri = FileProvider.getUriForFile(this, packageName + ".taskifysounds", File(path))
                        grantUriPermission("com.android.systemui", uri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
                        result.success(uri.toString())
                    } catch (e: Exception) {
                        result.error("URI", e.message, null)
                    }
                } else {
                    result.notImplemented()
                }
            }

        // 2) Live AI की आवाज़ का PCM प्लेबैक (AudioTrack, streaming)
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "taskify/pcm")
            .setMethodCallHandler { call, result ->
                when (call.method) {
                    "start" -> {
                        val rate = call.argument<Int>("rate") ?: 24000
                        audioExecutor.execute { startTrack(rate) }
                        result.success(null)
                    }
                    "write" -> {
                        val bytes = call.argument<ByteArray>("bytes")
                        if (bytes != null) {
                            audioExecutor.execute { track?.write(bytes, 0, bytes.size) }
                        }
                        result.success(null)
                    }
                    "flush" -> {
                        audioExecutor.execute {
                            track?.pause()
                            track?.flush()
                            track?.play()
                        }
                        result.success(null)
                    }
                    "stop" -> {
                        audioExecutor.execute { stopTrack() }
                        result.success(null)
                    }
                    else -> result.notImplemented()
                }
            }

        // 3) Google Text-to-Speech डेटा-इंस्टॉलर खोलना
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "taskify/tts")
            .setMethodCallHandler { call, result ->
                if (call.method == "openVoiceData") {
                    try {
                        val intent = Intent(TextToSpeech.Engine.ACTION_INSTALL_TTS_DATA)
                        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                        startActivity(intent)
                        result.success(true)
                    } catch (e: ActivityNotFoundException) {
                        result.success(false)
                    } catch (e: Exception) {
                        result.error("TTS_DATA", e.message, null)
                    }
                } else {
                    result.notImplemented()
                }
            }

        // 4) Home बटन दबाने पर भी Voice AI को बैकग्राउंड में चालू रखने के लिए Foreground Service
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "taskify/background")
            .setMethodCallHandler { call, result ->
                when (call.method) {
                    "startVoiceService" -> {
                        try {
                            val intent = Intent(this, TaskifyVoiceService::class.java)
                            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                                startForegroundService(intent)
                            } else {
                                startService(intent)
                            }
                            result.success(true)
                        } catch (e: Exception) {
                            result.success(false)
                        }
                    }
                    "stopVoiceService" -> {
                        try {
                            stopService(Intent(this, TaskifyVoiceService::class.java))
                            result.success(true)
                        } catch (e: Exception) {
                            result.success(false)
                        }
                    }
                    else -> result.notImplemented()
                }
            }

        // 5) Android Home Screen Apple-Glass Widget अपडेट करना
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "taskify/widget")
            .setMethodCallHandler { call, result ->
                if (call.method == "updateWidget") {
                    try {
                        val prefs = getSharedPreferences(TaskifyWidgetProvider.PREFS_NAME, MODE_PRIVATE)
                        val tasks = call.argument<List<String>>("tasks") ?: emptyList()
                        prefs.edit()
                            .putString("title", call.argument<String>("title") ?: "Taskify")
                            .putInt("done", call.argument<Int>("done") ?: 0)
                            .putInt("total", call.argument<Int>("total") ?: 0)
                            .putInt("streak", call.argument<Int>("streak") ?: 0)
                            .putString("task1", tasks.getOrNull(0) ?: "No pending tasks")
                            .putString("task2", tasks.getOrNull(1) ?: "")
                            .putString("task3", tasks.getOrNull(2) ?: "")
                            .apply()
                        TaskifyWidgetProvider.updateAll(this)
                        result.success(true)
                    } catch (e: Exception) {
                        result.success(false)
                    }
                } else {
                    result.notImplemented()
                }
            }

        // 6) 120Hz / 90Hz / 60Hz डिस्प्ले रिफ्रेश रेट सेट करना
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "taskify/display")
            .setMethodCallHandler { call, result ->
                if (call.method == "setRefreshRate") {
                    val hz = (call.argument<Int>("hz") ?: 120).toFloat()
                    targetHz = hz
                    applyRefreshRate(hz)
                    result.success(true)
                } else {
                    result.notImplemented()
                }
            }
    }

    private fun startTrack(rate: Int) {
        stopTrack()
        val minBuf = AudioTrack.getMinBufferSize(rate, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT)
        track = AudioTrack.Builder()
            .setAudioAttributes(
                AudioAttributes.Builder()
                    .setUsage(AudioAttributes.USAGE_MEDIA)
                    .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
                    .build()
            )
            .setAudioFormat(
                AudioFormat.Builder()
                    .setSampleRate(rate)
                    .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
                    .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
                    .build()
            )
            .setBufferSizeInBytes(minBuf * 4)
            .setTransferMode(AudioTrack.MODE_STREAM)
            .build()
        track?.play()
    }

    private fun stopTrack() {
        try {
            track?.stop()
        } catch (_: Exception) {
        }
        track?.release()
        track = null
    }

    override fun onDestroy() {
        audioExecutor.execute { stopTrack() }
        audioExecutor.shutdown()
        super.onDestroy()
    }
}

class TaskifyVoiceService : Service() {
    override fun onBind(intent: Intent?): IBinder? = null

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        val channelId = "taskify_voice_bg"
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val mgr = getSystemService(NotificationManager::class.java)
            val ch = NotificationChannel(
                channelId,
                "Taskify Voice AI",
                NotificationManager.IMPORTANCE_LOW
            )
            mgr?.createNotificationChannel(ch)
        }

        val launchIntent = packageManager.getLaunchIntentForPackage(packageName)
        val pending = if (launchIntent != null) {
            PendingIntent.getActivity(
                this,
                0,
                launchIntent,
                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
            )
        } else {
            null
        }

        val builder = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            Notification.Builder(this, channelId)
        } else {
            @Suppress("DEPRECATION")
            Notification.Builder(this)
        }

        val notification = builder
            .setContentTitle("Taskify Live Voice AI")
            .setContentText("Voice assistant is active in background")
            .setSmallIcon(android.R.drawable.ic_btn_speak_now)
            .setOngoing(true)
            .apply { if (pending != null) setContentIntent(pending) }
            .build()

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
            startForeground(
                9001,
                notification,
                ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE or ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK
            )
        } else {
            startForeground(9001, notification)
        }
        return START_STICKY
    }
}
