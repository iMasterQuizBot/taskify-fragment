<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tg_bg_violet"
    android:orientation="vertical"
    android:padding="11dp">
    <TextView
        android:id="@+id/wg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="FIRE STREAK"
        android:textColor="#A7B0C0"
        android:textSize="10sp"
        android:textStyle="bold" />
    <ProgressBar
        android:id="@+id/wg_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="78"
        android:progressDrawable="@drawable/tg_prog_violet" />
    <TextView
        android:id="@+id/wg_big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="🔥 14"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/wg_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Days active"
        android:textColor="#22D3EE"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</LinearLayout>
