open class TaskifyBaseWidgetProvider(private val widgetNo: Int) : AppWidgetProvider() {
    override fun onEnabled(context: Context) {
        super.onEnabled(context)
        TaskifyAllWidgets.updateOne(context, widgetNo)
    }

    override fun onUpdate(context: Context, appWidgetManager: AppWidgetManager, appWidgetIds: IntArray) {
        for (id in appWidgetIds) {
            TaskifyAllWidgets.bind(context, appWidgetManager, id, widgetNo)
        }
    }
}

class TaskifyWidgetActionReceiver : BroadcastReceiver() {
    override fun onReceive(context: Context, intent: Intent) {
        when (intent.action) {
            TaskifyAllWidgets.ACTION_COMPLETE_TOP -> {
                TaskifyAllWidgets.completeTopPendingTaskInDb(context)
                TaskifyAllWidgets.updateAll(context)
            }
            TaskifyAllWidgets.ACTION_SYNC -> {
                TaskifyAllWidgets.updateAll(context)
            }
        }
    }
}

object TaskifyAllWidgets {
    const val PREFS = "taskify_widget_prefs"
    const val ACTION_COMPLETE_TOP = "__PKG__.ACTION_COMPLETE_TOP"
    const val ACTION_SYNC = "__PKG__.ACTION_SYNC"

    private data class LiveSnapshot(
        val appTitle: String,
        val done: Int,
        val total: Int,
        val streak: Int,
        val studyMins: Int,
        val overdue: Int,
        val pending: Int,
        val weeklyPct: Int,
        val monthlyPct: Int,
        val mood: String,
        val nextTask: String,
        val tasks: List<String>,
        val freezeTokens: Int,
        val weekBars: List<Float>,
        val catBars: List<Pair<String, Float>>,
    )

    private fun readLiveSnapshot(context: Context): LiveSnapshot {
        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
        val appTitle = prefs.getString("title", "Taskifyy") ?: "Taskifyy"
        var done = prefs.getInt("done", 0)
        var total = prefs.getInt("total", 0)
        var streak = prefs.getInt("streak", 0)
        var studyMins = prefs.getInt("studyMins", 0)
        var overdue = prefs.getInt("overdueCount", 0)
        var pending = prefs.getInt("pendingCount", 0)
        var weeklyPct = prefs.getInt("weeklyPct", 0)
        var monthlyPct = prefs.getInt("monthlyPct", 0)
        var mood = prefs.getString("mood", "Focused") ?: "Focused"
        var nextTask = prefs.getString("nextTask", "No upcoming task") ?: "No upcoming task"
        var tasks = listOf(
            prefs.getString("task1", "Open Taskifyy to add tasks") ?: "",
            prefs.getString("task2", "") ?: "",
            prefs.getString("task3", "") ?: "",
            prefs.getString("task4", "") ?: "",
            prefs.getString("task5", "") ?: "",
        )
        var freezeTokens = 2
        val weekBars = MutableList(7) { 0.35f }
        val catDoneMap = linkedMapOf(
            "Study" to 0,
            "Work" to 0,
            "Health" to 0,
            "Fit" to 0,
            "Pers" to 0
        )

        try {
            val dbFile = context.getDatabasePath("my_daily_routine.db")
            if (dbFile.exists()) {
                val db = SQLiteDatabase.openDatabase(dbFile.path, null, SQLiteDatabase.OPEN_READONLY)
                val todayStr = SimpleDateFormat("yyyy-MM-dd", Locale.US).format(Date())
                val cal = Calendar.getInstance()
                val nowMins = cal.get(Calendar.HOUR_OF_DAY) * 60 + cal.get(Calendar.MINUTE)

                var dCount = 0
                var tCount = 0
                var pCount = 0
                var oCount = 0
                var sMins = 0
                val pList = mutableListOf<String>()

                val c = db.rawQuery(
                    "SELECT title, startMinutes, endMinutes, category, status FROM tasks WHERE date = ? ORDER BY startMinutes ASC, id ASC",
                    arrayOf(todayStr)
                )
                while (c.moveToNext()) {
                    val title = c.getString(0) ?: ""
                    val startM = c.getInt(1)
                    val endM = if (c.isNull(2)) null else c.getInt(2)
                    val cat = (c.getString(3) ?: "").lowercase(Locale.US)
                    val status = c.getString(4) ?: "pending"

                    if (status == "skipped") continue
                    tCount++
                    if (status == "completed") {
                        dCount++
                        if (cat == "study" || cat == "learning") {
                            val dur = (endM ?: (startM + 60)) - startM
                            if (dur > 0) sMins += dur
                            catDoneMap["Study"] = (catDoneMap["Study"] ?: 0) + 1
                        } else if (cat == "work") {
                            catDoneMap["Work"] = (catDoneMap["Work"] ?: 0) + 1
                        } else if (cat == "health") {
                            catDoneMap["Health"] = (catDoneMap["Health"] ?: 0) + 1
                        } else if (cat == "exercise") {
                            catDoneMap["Fit"] = (catDoneMap["Fit"] ?: 0) + 1
                        } else {
                            catDoneMap["Pers"] = (catDoneMap["Pers"] ?: 0) + 1
                        }
                    } else if (status == "pending") {
                        pCount++
                        val endCheck = endM ?: startM
                        if (nowMins > endCheck) oCount++
                        if (pList.size < 5) {
                            pList.add("${formatMins(startM)} • $title")
                        }
                    }
                }
                c.close()

                // Last 7 days completion bars
                val fmt = SimpleDateFormat("yyyy-MM-dd", Locale.US)
                for (i in 0..6) {
                    val dCal = Calendar.getInstance()
                    dCal.add(Calendar.DAY_OF_YEAR, -(6 - i))
                    val dStr = fmt.format(dCal.time)
                    val dc = db.rawQuery("SELECT status FROM tasks WHERE date = ? AND status != 'skipped'", arrayOf(dStr))
                    var tot = 0
                    var dn = 0
                    while (dc.moveToNext()) {
                        tot++
                        if (dc.getString(0) == "completed") dn++
                    }
                    dc.close()
                    weekBars[i] = if (tot == 0) 0.12f else (dn.toFloat() / tot.toFloat()).coerceIn(0.12f, 1.0f)
                }

                val mCur = db.rawQuery("SELECT mood FROM mood_logs WHERE date = ? LIMIT 1", arrayOf(todayStr))
                if (mCur.moveToFirst()) mood = mCur.getString(0) ?: mood
                mCur.close()

                val fCur = db.rawQuery("SELECT value FROM settings WHERE key = 'streakFreezeTokens' LIMIT 1", null)
                if (fCur.moveToFirst()) freezeTokens = fCur.getString(0)?.toIntOrNull() ?: 2
                fCur.close()
                db.close()

                done = dCount
                total = tCount
                pending = pCount
                overdue = oCount
                studyMins = sMins
                if (pList.isNotEmpty()) {
                    nextTask = pList.first()
                    tasks = List(5) { idx -> pList.getOrElse(idx) { "" } }
                } else if (tCount > 0) {
                    nextTask = "All tasks completed!"
                    tasks = listOf("🏆 All tasks completed today!", "", "", "", "")
                }
                val pctNow = if (total == 0) 0 else (done * 100) / total
                if (weeklyPct == 0) weeklyPct = pctNow
                if (monthlyPct == 0) monthlyPct = pctNow
            }
        } catch (_: Exception) {}

        val maxCat = (catDoneMap.values.maxOrNull() ?: 1).coerceAtLeast(1)
        val catBars = catDoneMap.entries.map { it.key to (it.value.toFloat() / maxCat.toFloat()).coerceIn(0.15f, 1.0f) }

        return LiveSnapshot(
            appTitle = appTitle,
            done = done,
            total = total,
            streak = streak,
            studyMins = studyMins,
            overdue = overdue,
            pending = pending,
            weeklyPct = weeklyPct,
            monthlyPct = monthlyPct,
            mood = mood,
            nextTask = nextTask,
            tasks = tasks,
            freezeTokens = freezeTokens,
            weekBars = weekBars,
            catBars = catBars,
        )
    }

    private fun drawRingBitmap(pct: Int, c1: Int, c2: Int, centerText: String): Bitmap {
        val size = 220
        val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val stroke = 20f
        val rect = RectF(stroke, stroke, size - stroke, size - stroke)

        val bgPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE
            strokeWidth = stroke
            color = Color.argb(45, 255, 255, 255)
        }
        canvas.drawOval(rect, bgPaint)

        val fgPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE
            strokeWidth = stroke
            strokeCap = Paint.Cap.ROUND
            shader = LinearGradient(0f, 0f, size.toFloat(), size.toFloat(), c1, c2, Shader.TileMode.CLAMP)
        }
        val sweep = (360f * pct.coerceIn(0, 100)) / 100f
        canvas.drawArc(rect, -90f, sweep.coerceAtLeast(8f), false, fgPaint)

        val txtPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.WHITE
            textSize = 44f
            typeface = Typeface.DEFAULT_BOLD
            textAlign = Paint.Align.CENTER
        }
        canvas.drawText(centerText, size / 2f, size / 2f + 15f, txtPaint)
        return bmp
    }

    private fun drawBarChartBitmap(bars: List<Float>, labels: List<String>, c1: Int, c2: Int): Bitmap {
        val w = 480
        val h = 150
        val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val count = bars.size.coerceAtLeast(1)
        val slotW = w.toFloat() / count
        val barW = slotW * 0.52f
        val topPad = 12f
        val bottomPad = 28f
        val maxH = h - topPad - bottomPad

        val trackPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.argb(35, 255, 255, 255) }
        val txtPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.argb(200, 167, 176, 192)
            textSize = 20f
            typeface = Typeface.DEFAULT_BOLD
            textAlign = Paint.Align.CENTER
        }

        for (i in 0 until count) {
            val cx = i * slotW + slotW / 2f
            val left = cx - barW / 2f
            val right = cx + barW / 2f
            val trackRect = RectF(left, topPad, right, topPad + maxH)
            canvas.drawRoundRect(trackRect, 12f, 12f, trackPaint)

            val bh = maxH * bars[i].coerceIn(0.1f, 1.0f)
            val barRect = RectF(left, topPad + maxH - bh, right, topPad + maxH)
            val barPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                shader = LinearGradient(left, barRect.top, right, barRect.bottom, c1, c2, Shader.TileMode.CLAMP)
            }
            canvas.drawRoundRect(barRect, 12f, 12f, barPaint)

            if (i < labels.size) {
                canvas.drawText(labels[i], cx, h - 6f, txtPaint)
            }
        }
        return bmp
    }

    private fun drawOrbBitmap(): Bitmap {
        val size = 200
        val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        val glow = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.argb(90, 34, 211, 238)
        }
        canvas.drawCircle(size / 2f, size / 2f, 88f, glow)
        val core = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            shader = LinearGradient(20f, 20f, 180f, 180f, Color.parseColor("#8B5CF6"), Color.parseColor("#22D3EE"), Shader.TileMode.CLAMP)
        }
        canvas.drawCircle(size / 2f, size / 2f, 64f, core)
        val hi = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.argb(110, 255, 255, 255) }
        canvas.drawCircle(size / 2f - 16f, size / 2f - 16f, 22f, hi)
        return bmp
    }

    fun completeTopPendingTaskInDb(context: Context) {
        try {
            val dbFile = context.getDatabasePath("my_daily_routine.db")
            if (!dbFile.exists()) return
            val db = SQLiteDatabase.openDatabase(dbFile.path, null, SQLiteDatabase.OPEN_READWRITE)
            val todayStr = SimpleDateFormat("yyyy-MM-dd", Locale.US).format(Date())
            val c = db.rawQuery(
                "SELECT id FROM tasks WHERE date = ? AND status = 'pending' ORDER BY startMinutes ASC, id ASC LIMIT 1",
                arrayOf(todayStr)
            )
            if (c.moveToFirst()) {
                val id = c.getInt(0)
                val nowIso = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss", Locale.US).format(Date())
                db.execSQL("UPDATE tasks SET status = 'completed', updatedAt = ? WHERE id = ?", arrayOf(nowIso, id))
            }
            c.close()
            db.close()
        } catch (_: Exception) {}
    }

    private fun formatMins(minutes: Int): String {
        val h24 = (minutes / 60) % 24
        val m = minutes % 60
        val ampm = if (h24 >= 12) "PM" else "AM"
        val h12 = if (h24 % 12 == 0) 12 else h24 % 12
        return String.format(Locale.US, "%02d:%02d %s", h12, m, ampm)
    }

    fun updateAll(context: Context) {
        for (no in 1..42) updateOne(context, no)
    }

    fun updateOne(context: Context, no: Int) {
        try {
            val mgr = AppWidgetManager.getInstance(context)
            val clsName = "${context.packageName}.TaskifyWidget${no.toString().padStart(2, '0')}"
            val cls = Class.forName(clsName)
            val ids = mgr.getAppWidgetIds(ComponentName(context, cls))
            for (id in ids) bind(context, mgr, id, no)
        } catch (_: Exception) {}
    }

    private fun launchPending(context: Context, reqCode: Int, actionKey: String): PendingIntent {
        val intent = context.packageManager.getLaunchIntentForPackage(context.packageName)?.apply {
            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP or Intent.FLAG_ACTIVITY_CLEAR_TOP)
            putExtra("widget_action", actionKey)
        } ?: Intent()
        return PendingIntent.getActivity(context, reqCode, intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
    }

    private fun broadcastPending(context: Context, reqCode: Int, action: String): PendingIntent {
        val intent = Intent(context, TaskifyWidgetActionReceiver::class.java).apply { this.action = action }
        return PendingIntent.getBroadcast(context, reqCode, intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
    }

    fun bind(context: Context, mgr: AppWidgetManager, appWidgetId: Int, no: Int) {
